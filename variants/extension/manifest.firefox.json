{
  "manifest_version": 3,
  "name": "TEZAUR",
  "version": "1.1",
  "description": "Asistent local de cercetare pentru teză, cu citări verificabile.",
  "action": {
    "default_title": "TEZAUR"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tezaur@trom.tf",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "contextMenus"
  ],
  "sidebar_action": {
    "default_panel": "app/index.html",
    "default_title": "TEZAUR",
    "open_at_install": false
  }
}
