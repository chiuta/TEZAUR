<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.tezaur.serve</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/tezaur</string><string>serve</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>TEZAUR_INDEX</key><string>~/Library/Application Support/TEZAUR/tezaur.idx</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/tezaur.err</string>
</dict></plist>
